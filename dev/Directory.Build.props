<?xml version="1.0" encoding="UTF-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Release'))">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <Version>7.0.0.26278+2233</Version>
    <Copyright>Copyright © 2014-2026</Copyright>
    <Company>pyRevitLabs.io</Company>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseRevit)' == 'true' and '$(RevitVersion)' != '2019'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.UIFramework" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.UIFrameworkServices" Version="$(RevitVersion).*" />
  </ItemGroup>
  <PropertyGroup>
    <Revit2019Path Condition="'$(Revit2019Path)' == ''">$(ProgramFiles)\Autodesk\Revit 2019</Revit2019Path>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseRevit)' == 'true' and '$(RevitVersion)' == '2019'">
    <Reference Include="RevitAPI" HintPath="$(Revit2019Path)\RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(Revit2019Path)\RevitAPIUI.dll" Private="false" />
    <Reference Include="AdWindows" HintPath="$(Revit2019Path)\AdWindows.dll" Private="false" />
    <Reference Include="UIFramework" HintPath="$(Revit2019Path)\UIFramework.dll" Private="false" />
    <Reference Include="UIFrameworkServices" HintPath="$(Revit2019Path)\UIFrameworkServices.dll" Private="false" />
    <Reference Include="Xceed.Wpf.AvalonDock" HintPath="$(Revit2019Path)\Xceed.Wpf.AvalonDock.dll" Private="false" />
  </ItemGroup>
</Project>
